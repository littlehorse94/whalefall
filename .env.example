# Vercel Blob read/write token for this project's Blob store (Project → Storage → your Blob store → .env.local tab).
BLOB_READ_WRITE_TOKEN=

# Single admin login credentials for /admin.
ADMIN_USERNAME=
# bcrypt hash of the admin password — never put the plaintext password here.
ADMIN_PASSWORD_HASH=

# Random secret used to sign the admin session cookie (32+ random bytes, hex-encoded).
SESSION_SECRET=
